NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Demo mode — set to "true" for hackathon/demo environments
NEXT_PUBLIC_DEMO_MODE=false

# Payment provider — "demo" = auto-confirm after 2s, "astrapay" = real sandbox
NEXT_PUBLIC_PAYMENT_PROVIDER=astrapay

# AstraPay Sandbox
ASTRAPAY_SANDBOX_BASE_URL=https://sandbox.astrapay.com
ASTRAPAY_SANDBOX_CLIENT_ID=your_astrapay_client_id
ASTRAPAY_SANDBOX_CLIENT_SECRET=your_astrapay_client_secret
ASTRAPAY_SANDBOX_MERCHANT_ID=your_astrapay_merchant_id
# Path to PKCS8 private key PEM file
ASTRAPAY_PRIVATE_KEY_PATH=/path/to/pkcs8_rsa_private_key.pem
